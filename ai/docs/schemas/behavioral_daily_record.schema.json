  "$defs": {
    "nullableDayMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1440
    },
    "nullableNonNegativeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullableTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "time",
      "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "dataSource": {
      "type": "string",
      "enum": [
        "health_platform",
        "manual",
        "synthetic",
        "not_provided"
      ]
    },
    "dataCoverage": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    }
  },
