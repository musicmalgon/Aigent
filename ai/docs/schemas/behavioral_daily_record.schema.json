{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavioral_daily_record.schema.json",
  "title": "BehavioralDailyRecord",
  "description": "필드별 출처와 수집 상태를 포함하는 일별 생활 기록.",
  "$comment": "examples의 모든 값은 스키마 검증용 합성 데이터다. null은 값 없음이고 숫자 0은 측정된 값이다. time_zone은 date와 현지 시각을 산출할 때 사용한 IANA 시간대 식별자를 보존한다. JSON Schema와 Pydantic 모두 coverage가 unavailable인 필드는 null, complete 또는 partial인 필드는 관측값이어야 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "date",
    "time_zone",
    "sleep_minutes",
    "bedtime",
    "wake_time",
    "steps",
    "active_minutes",
    "exercise_minutes",
    "work_or_study_minutes",
    "rest_minutes",
    "schedule_count",
    "subjective_fatigue",
    "source_by_field",
    "coverage_by_field"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time_zone": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._+-]*(?:/[A-Za-z0-9][A-Za-z0-9._+-]*)*$",
      "not": {
        "pattern": "\\s"
      },
      "description": "date, bedtime, wake_time의 현지 경계를 산출할 때 사용한 IANA 시간대 식별자. 이 값은 과거 기록과 함께 보존한다."
    },
    "sleep_minutes": {
      "$ref": "#/$defs/nullableDayMinutes"
    },
    "bedtime": {
      "$ref": "#/$defs/nullableTime"
    },
    "wake_time": {
      "$ref": "#/$defs/nullableTime"
    },
    "steps": {
      "$ref": "#/$defs/nullableNonNegativeInteger"
    },
    "active_minutes": {
      "$ref": "#/$defs/nullableDayMinutes"
    },
    "exercise_minutes": {
      "$ref": "#/$defs/nullableDayMinutes"
    },
    "work_or_study_minutes": {
      "$ref": "#/$defs/nullableDayMinutes"
    },
    "rest_minutes": {
      "$ref": "#/$defs/nullableDayMinutes"
    },
    "schedule_count": {
      "$ref": "#/$defs/nullableNonNegativeInteger"
    },
    "subjective_fatigue": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "척도 상한은 아직 확정하지 않는다."
    },
    "source_by_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sleep_minutes",
        "bedtime",
        "wake_time",
        "steps",
        "active_minutes",
        "exercise_minutes",
        "work_or_study_minutes",
        "rest_minutes",
        "schedule_count",
        "subjective_fatigue"
      ],
      "properties": {
        "sleep_minutes": {
          "$ref": "#/$defs/dataSource"
        },
        "bedtime": {
          "$ref": "#/$defs/dataSource"
        },
        "wake_time": {
          "$ref": "#/$defs/dataSource"
        },
        "steps": {
          "$ref": "#/$defs/dataSource"
        },
        "active_minutes": {
          "$ref": "#/$defs/dataSource"
        },
        "exercise_minutes": {
          "$ref": "#/$defs/dataSource"
        },
        "work_or_study_minutes": {
          "$ref": "#/$defs/dataSource"
        },
        "rest_minutes": {
          "$ref": "#/$defs/dataSource"
        },
        "schedule_count": {
          "$ref": "#/$defs/dataSource"
        },
        "subjective_fatigue": {
          "$ref": "#/$defs/dataSource"
        }
      },
      "description": "모든 nullable 생활 필드의 출처를 명시한다."
    },
    "coverage_by_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sleep_minutes",
        "bedtime",
        "wake_time",
        "steps",
        "active_minutes",
        "exercise_minutes",
        "work_or_study_minutes",
        "rest_minutes",
        "schedule_count",
        "subjective_fatigue"
      ],
      "properties": {
        "sleep_minutes": {
          "$ref": "#/$defs/dataCoverage"
        },
        "bedtime": {
          "$ref": "#/$defs/dataCoverage"
        },
        "wake_time": {
          "$ref": "#/$defs/dataCoverage"
        },
        "steps": {
          "$ref": "#/$defs/dataCoverage"
        },
        "active_minutes": {
          "$ref": "#/$defs/dataCoverage"
        },
        "exercise_minutes": {
          "$ref": "#/$defs/dataCoverage"
        },
        "work_or_study_minutes": {
          "$ref": "#/$defs/dataCoverage"
        },
        "rest_minutes": {
          "$ref": "#/$defs/dataCoverage"
        },
        "schedule_count": {
          "$ref": "#/$defs/dataCoverage"
        },
        "subjective_fatigue": {
          "$ref": "#/$defs/dataCoverage"
        }
      },
      "description": "모든 nullable 생활 필드의 수집 상태를 명시한다."
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "sleep_minutes": {
              "type": "null"
            },
            "coverage_by_field": {
              "properties": {
                "sleep_minutes": {
                  "const": "unavailable"
