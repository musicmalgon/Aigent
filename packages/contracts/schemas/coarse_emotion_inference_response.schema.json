{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coarse_emotion_inference_response.schema.json",
  "title": "CoarseEmotionInferenceResponse",
  "description": "비의료적 6-class 감정 분류 결과. 진단, 치료 또는 번아웃 판정으로 사용하지 않는다.",
  "$comment": "examples의 값은 모두 합성 결과다. probabilities는 추세 집계를 위한 모델 출력이며 의료적 확률이나 진단 신뢰도가 아니다. 확률 합, argmax/confidence 일치, top_predictions 정렬은 서비스 런타임 계약에서 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "predicted_emotion",
    "predicted_label_id",
    "confidence",
    "is_uncertain",
    "uncertainty_reason",
    "probabilities",
    "top_predictions",
    "latency_ms"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "predicted_emotion": {
      "$ref": "#/$defs/coarseEmotionLabel"
    },
    "predicted_label_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "confidence": {
      "$ref": "#/$defs/probability"
    },
    "is_uncertain": {
      "type": "boolean"
    },
    "uncertainty_reason": {
      "oneOf": [
        {
          "$ref": "#/$defs/uncertaintyReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "기쁨",
        "불안",
        "당황",
        "분노",
        "슬픔",
        "상처"
      ],
      "properties": {
        "기쁨": { "$ref": "#/$defs/probability" },
        "불안": { "$ref": "#/$defs/probability" },
        "당황": { "$ref": "#/$defs/probability" },
        "분노": { "$ref": "#/$defs/probability" },
        "슬픔": { "$ref": "#/$defs/probability" },
        "상처": { "$ref": "#/$defs/probability" }
      }
    },
    "top_predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/topPrediction"
      }
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": { "properties": { "predicted_emotion": { "const": "기쁨" } }, "required": ["predicted_emotion"] },
      "then": { "properties": { "predicted_label_id": { "const": 0 } } }
    },
    {
      "if": { "properties": { "predicted_emotion": { "const": "불안" } }, "required": ["predicted_emotion"] },
      "then": { "properties": { "predicted_label_id": { "const": 1 } } }
    },
    {
      "if": { "properties": { "predicted_emotion": { "const": "당황" } }, "required": ["predicted_emotion"] },
      "then": { "properties": { "predicted_label_id": { "const": 2 } } }
    },
    {
      "if": { "properties": { "predicted_emotion": { "const": "분노" } }, "required": ["predicted_emotion"] },
      "then": { "properties": { "predicted_label_id": { "const": 3 } } }
    },
    {
      "if": { "properties": { "predicted_emotion": { "const": "슬픔" } }, "required": ["predicted_emotion"] },
      "then": { "properties": { "predicted_label_id": { "const": 4 } } }
    },
    {
      "if": { "properties": { "predicted_emotion": { "const": "상처" } }, "required": ["predicted_emotion"] },
      "then": { "properties": { "predicted_label_id": { "const": 5 } } }
    },
    {
      "if": { "properties": { "is_uncertain": { "const": false } }, "required": ["is_uncertain"] },
      "then": { "properties": { "uncertainty_reason": { "type": "null" } } }
    },
    {
      "if": { "properties": { "is_uncertain": { "const": true } }, "required": ["is_uncertain"] },
      "then": { "properties": { "uncertainty_reason": { "$ref": "#/$defs/uncertaintyReason" } } }
    }
  ],
  "$defs": {
    "coarseEmotionLabel": {
      "type": "string",
      "enum": [
        "기쁨",
        "불안",
        "당황",
        "분노",
        "슬픔",
        "상처"
      ]
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertaintyReason": {
      "type": "string",
      "enum": [
        "low_confidence",
        "small_margin",
        "low_confidence_and_small_margin"
      ]
    },
    "topPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotion",
        "label_id",
        "probability"
      ],
      "properties": {
        "emotion": {
          "$ref": "#/$defs/coarseEmotionLabel"
        },
        "label_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "probability": {
          "$ref": "#/$defs/probability"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "emotion": { "const": "기쁨" } }, "required": ["emotion"] },
          "then": { "properties": { "label_id": { "const": 0 } } }
        },
        {
          "if": { "properties": { "emotion": { "const": "불안" } }, "required": ["emotion"] },
          "then": { "properties": { "label_id": { "const": 1 } } }
        },
        {
          "if": { "properties": { "emotion": { "const": "당황" } }, "required": ["emotion"] },
          "then": { "properties": { "label_id": { "const": 2 } } }
        },
        {
          "if": { "properties": { "emotion": { "const": "분노" } }, "required": ["emotion"] },
          "then": { "properties": { "label_id": { "const": 3 } } }
        },
        {
          "if": { "properties": { "emotion": { "const": "슬픔" } }, "required": ["emotion"] },
          "then": { "properties": { "label_id": { "const": 4 } } }
        },
        {
          "if": { "properties": { "emotion": { "const": "상처" } }, "required": ["emotion"] },
          "then": { "properties": { "label_id": { "const": 5 } } }
        }
      ]
    }
  },
  "examples": [
    {
      "model_version": "klue-roberta-coarse-v1",
      "predicted_emotion": "불안",
      "predicted_label_id": 1,
      "confidence": 0.54,
      "is_uncertain": false,
      "uncertainty_reason": null,
      "probabilities": {
        "기쁨": 0.03,
        "불안": 0.54,
        "당황": 0.14,
        "분노": 0.08,
        "슬픔": 0.13,
        "상처": 0.08
      },
      "top_predictions": [
        {
          "emotion": "불안",
          "label_id": 1,
          "probability": 0.54
        },
        {
          "emotion": "당황",
          "label_id": 2,
          "probability": 0.14
        }
      ],
      "latency_ms": 18.4
    }
  ]
}
