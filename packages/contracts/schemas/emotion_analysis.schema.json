{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emotion_analysis.schema.json",
  "title": "EmotionAnalysis",
  "description": "감정 일기에 대한 비의료적 감정 분류 결과.",
  "$comment": "examples의 모든 값은 스키마 검증용 합성 결과다. confidence는 개별 분류의 모델 신뢰도이며 의료적 확률이나 모델 성능 수치가 아니다. 관련성 boolean의 null은 해당 관계를 아직 판정하지 않았음을 뜻하며 false와 다르다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_emotion",
    "secondary_signals",
    "confidence",
    "cause_tags",
    "sleep_related",
    "workload_related",
    "model_name",
    "model_version"
  ],
  "properties": {
    "primary_emotion": {
      "$ref": "#/$defs/emotionLabel"
    },
    "secondary_signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/emotionLabel"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cause_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/causeTag"
      }
    },
    "sleep_related": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "workload_related": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "primary_emotion": {
            "const": "stable"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_signals": {
            "items": {
              "not": {
                "const": "stable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "primary_emotion": {
            "const": "fatigue"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_signals": {
            "items": {
              "not": {
                "const": "fatigue"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "primary_emotion": {
            "const": "anxiety"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_signals": {
            "items": {
              "not": {
                "const": "anxiety"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "primary_emotion": {
            "const": "other"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_signals": {
            "items": {
              "not": {
                "const": "other"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "emotionLabel": {
      "type": "string",
      "enum": [
        "stable",
        "fatigue",
        "anxiety",
        "other"
      ]
    },
    "causeTag": {
      "type": "string",
      "enum": [
        "sleep",
        "workload",
        "academic",
        "job_search",
        "relationship",
        "daily_routine",
        "unspecified"
      ]
    }
  },
  "examples": [
    {
      "primary_emotion": "fatigue",
      "secondary_signals": [
        "anxiety"
      ],
      "confidence": 0.72,
      "cause_tags": [
        "sleep",
        "workload"
      ],
      "sleep_related": null,
      "workload_related": null,
      "model_name": "synthetic_stub",
      "model_version": "foundation-draft"
    }
  ]
}
