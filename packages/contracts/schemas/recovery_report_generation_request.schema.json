{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery_report_generation_request.schema.json",
  "title": "RecoveryReportGenerationRequest",
  "description": "Deterministic facts and preselected recovery actions supplied to the report copy generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_level",
    "risk_score",
    "is_provisional",
    "data_quality",
    "period",
    "changes",
    "selected_actions",
    "prompt_version"
  ],
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": ["low", "moderate", "high", "very_high"]
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "is_provisional": {
      "type": "boolean"
    },
    "data_quality": {
      "type": "string",
      "enum": ["sufficient", "insufficient"]
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "selected_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "stage2_signal_drivers": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "prompt_version": {
      "type": "string",
      "const": "recovery-report-prompt-v1"
    }
  },
  "$defs": {
    "factorCode": {
      "type": "string",
      "enum": [
        "sleep_decrease",
        "workload_increase",
        "schedule_overload",
        "rest_decrease",
        "exercise_decrease",
        "negative_emotion_increase",
        "high_negative_emotion",
        "subjective_stress",
        "subjective_fatigue"
      ]
    },
    "metric": {
      "type": ["string", "null"],
      "enum": [
        "sleep_minutes",
        "work_or_study_minutes",
        "rest_minutes",
        "exercise_minutes",
        "schedule_count",
        "negative_emotion_probability",
        "subjective_stress",
        "subjective_fatigue",
        null
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "record_days"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "record_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_code",
        "metric",
        "recent_value",
        "baseline_value",
        "delta",
        "change_percent",
        "sample_days",
        "fact_text"
      ],
      "properties": {
        "factor_code": {
          "$ref": "#/$defs/factorCode"
        },
        "metric": {
          "$ref": "#/$defs/metric"
        },
        "recent_value": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "baseline_value": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "delta": {
          "type": ["number", "null"]
        },
        "change_percent": {
          "type": ["number", "null"]
        },
        "sample_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "fact_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "duration_minutes", "difficulty"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "REST_30",
            "SLEEP_EARLY_60",
            "LIGHT_ACTIVITY_20",
            "SCHEDULE_REDUCE_ONE",
            "JOURNAL_CHECKIN_10",
            "ROUTINE_CHECK_5"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "duration_minutes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1440
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium"]
        }
      }
    }
  }
}
