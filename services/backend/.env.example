# Local development values only. Never commit a populated .env file.
APP_ENV=development
DATABASE_URL=sqlite:///./remind.db
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SQLADMIN_ENABLED=false
SQLADMIN_PATH=/admin
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_CONNECT_TIMEOUT_SECONDS=5
AI_SERVICE_READ_TIMEOUT_SECONDS=30
AI_SERVICE_WRITE_TIMEOUT_SECONDS=10
AI_SERVICE_POOL_TIMEOUT_SECONDS=5
# Optional deployment-level bearer token. The current AI app does not require it.
AI_SERVICE_AUTH_TOKEN=
